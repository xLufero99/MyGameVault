# Copia este archivo a .env y sustituye los valores. NFR-08: .env nunca se versiona.

# Supabase Database (Transaction Pooler - IPv4).
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password

# Región del pooler (hostname aws-0-{region}.pooler.supabase.com).
SUPABASE_POOLER_REGION=us-east-1

# Supabase API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key

# Algoritmo de firma de JWT (NFR-05).
JWT_ALGORITHM=HS256

# Vida del access token en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos por CORS (separados por comas).
ALLOWED_ORIGINS=https://mygamevault.pages.dev,http://localhost:5173
