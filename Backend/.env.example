# Copia este archivo como .env y completa los valores.
# URL de conexion directa a Supabase (PostgreSQL)
DB_URL=jdbc:postgresql://db.<tu-project-ref>.supabase.co:5432/postgres
DB_USER=postgres
DB_PASSWORD=
# Cambiar a "transaction" si se usa el pooler.
DB_POOL_MODE=direct

# ALTERNATIVA: Transaction Pooler (puerto 6543, IPv4)
# Usar si la conexion directa falla por temas de IPv6.
# Descomenta las siguientes dos lineas y comenta las de arriba:
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres
# DB_USER=postgres.<tu-project-ref>