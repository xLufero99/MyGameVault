# Copia este archivo a .env y sustituye los valores. NFR-08: .env nunca se versiona.
# URL de conexión a PostgreSQL (driver psycopg 3).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mygamevault

# Secreto para firmar JWT (NFR-05). Usa un valor largo y aleatorio en producción.
JWT_SECRET=change-me-in-production

# Algoritmo de firma de JWT.
JWT_ALGORITHM=HS256

# Vida del access token en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60